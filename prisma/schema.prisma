generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  email              String   @unique
  name               String
  passwordHash       String
  hashedRefreshToken String?
  createdAt          DateTime @default(now())

  resumes Resume[]
  activities Activity[]
}

model Resume {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions ResumeVersion[]
  activities Activity[]
}

model ResumeVersion {
  id            String   @id @default(uuid()) @db.Uuid
  resumeId      String   @db.Uuid()
  versionNumber Int
  createdAt     DateTime @default(now())
  rawText       String   @db.Text
  source        String

  resume   Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  analysis Analysis?
  activities Activity[]
}

model Analysis {
  id              String        @id @default(uuid()) @db.Uuid
  resumeVersionId String        @unique @db.Uuid
  resumeVersion   ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  targetRole           String?
  targetJobDescription String? @db.Text
  aiVerdict            String  @db.Text

  scoreBreakdown    Json? // { keywords: 18, formatting: 20, impact: 10, clarity: 20 }
  parsedData        Json // structured resume: { basics, summary, experience[], education[], skills[], ... }
  recruiterConcerns Json
  missingSkills     Json

  resumeHealthScore Float
  issues            Json // [{ category, issue, severity, fixSuggestion }]
  strengths         Json? // [{ category, strength, detail }]
  keywords          Json? // { present: [...], missing: [...], matchRate, total }
  rewrites          Json? // [{ section, original, rewritten, rationale }]
  createdAt         DateTime @default(now())
}

model Activity {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  resumeId        String?        @db.Uuid
  resumeVersionId String?        @db.Uuid
  actionType      String         // 'UPLOAD', 'ANALYZE', 'REWRITE', 'EXPORT'
  details         Json?          // { oldScore, newScore, rewritesApplied, etc. }
  createdAt       DateTime       @default(now())

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume          Resume?        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeVersion   ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
}
